{
  "info": {
    "name": "REOS API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        }
      ]
    },
    {
      "name": "2. Sales Executive",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/executive/dashboard", "host": ["{{base_url}}"], "path": ["executive", "dashboard"] }
          }
        },
        {
          "name": "Clock-in",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/executive/attendance/clock-in", "host": ["{{base_url}}"], "path": ["executive", "attendance", "clock-in"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"work_location\": \"office\",\n  \"latitude\": 17.432,\n  \"longitude\": 78.432\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/executive/leads", "host": ["{{base_url}}"], "path": ["executive", "leads"] }
          }
        },
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/executive/leads", "host": ["{{base_url}}"], "path": ["executive", "leads"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"phone\": \"9876543210\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Schedule Follow-up",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/executive/leads/1/follow-ups", "host": ["{{base_url}}"], "path": ["executive", "leads", "1", "follow-ups"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduled_at\": \"2026-10-01 14:30:00\",\n  \"type\": \"call\",\n  \"notes\": \"Call back later\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/executive/bookings", "host": ["{{base_url}}"], "path": ["executive", "bookings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lead_id\": 1,\n  \"project_id\": 1,\n  \"unit_id\": 101\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "3. Manager",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/manager/dashboard", "host": ["{{base_url}}"], "path": ["manager", "dashboard"] }
          }
        },
        {
          "name": "List Team Members",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/manager/team", "host": ["{{base_url}}"], "path": ["manager", "team"] }
          }
        },
        {
          "name": "Approve Leave",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/manager/team/leaves/1/approve", "host": ["{{base_url}}"], "path": ["manager", "team", "leaves", "1", "approve"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    }
  ]
}
